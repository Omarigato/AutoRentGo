# ==============================================================================
# AutoRentGo - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables for your deployment environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Core Settings
# ------------------------------------------------------------------------------
APP_NAME=AutoRentGo
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=production
API_V1_STR=/api/v1
HOST=0.0.0.0
BACKEND_PORT=8000

# Secret key for signing JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS origins (comma-separated list or "*" for permissive dev)
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL / SQLite)
# ------------------------------------------------------------------------------
# When using Docker Compose, the database credentials below are passed to Postgres.
POSTGRES_USER=autorentgo
POSTGRES_PASSWORD=autorentgo_secret_password
POSTGRES_DB=autorentgo

# Database Connection URI:
# For local dev / testing without PostgreSQL, leave empty to automatically fallback to SQLite:
# SQLALCHEMY_DATABASE_URI=sqlite:///./autorentgo.db
# For Docker Compose, the connection string is injected automatically:
# SQLALCHEMY_DATABASE_URI=postgresql://autorentgo:autorentgo_secret_password@db:5432/autorentgo
SQLALCHEMY_DATABASE_URI=

# ------------------------------------------------------------------------------
# 3. Frontend & Gateway URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=/api/v1
FRONTEND_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Email Service (SMTP - Optional)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_USE_TLS=true
EMAIL_FROM=AutoRentGo <noreply@example.com>

# ------------------------------------------------------------------------------
# 5. Media & Image Storage (Cloudinary - Optional)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 6. Notification Integrations (Optional)
# ------------------------------------------------------------------------------
# Telegram Admin Bot
TELEGRAM_NOTIFICATION_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_telegram_admin_chat_id

# WhatsApp Notifications (Provider / Webhook)
WHATSAPP_API_URL=https://api.whatsapp-provider.com/v1/messages
WHATSAPP_API_TOKEN=your_whatsapp_bearer_token

# Alternative WhatsApp Gateway (e.g., Whapi.cloud / Self-hosted gateway)
WHATSAPP_ALT_API_URL=https://gate.whapi.cloud
WHATSAPP_ALT_API_TOKEN=your_whapi_token_here